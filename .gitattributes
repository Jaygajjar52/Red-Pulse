# Normalise line endings so encoding/formatting issues cannot recur.
* text=auto eol=lf

# Windows-specific scripts must stay CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Binary files - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.pdf binary

# Lockfiles must not be merged
package-lock.json merge=binary linguist-generated=true
*.lock merge=binary
