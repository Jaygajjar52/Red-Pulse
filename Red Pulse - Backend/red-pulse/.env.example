# ===================================================================
# RED PULSE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ===================================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/redpulse
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# JWT Security Settings
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Firebase Admin SDK (server-side only; disabled until all values are configured)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=

# Development-only administrator bootstrap (disabled by default)
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_PHONE=replace-with-a-valid-phone

# Emergency email OTP security (Gmail App Password required; never use a normal Gmail password)
MAIL_USERNAME=your-redpulse-gmail@gmail.com
MAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_OTP_ENABLED=true
EMAIL_OTP_EXPIRATION_SECONDS=300
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_REQUESTS_PER_EMAIL=5
EMAIL_OTP_MAX_REQUESTS_PER_IP=20
EMERGENCY_VERIFICATION_EXPIRATION_SECONDS=600

# Legacy/general OTP settings
EMERGENCY_OTP_EXPIRATION_SECONDS=300
EMERGENCY_OTP_MAX_ATTEMPTS=5
EMERGENCY_OTP_RESEND_THROTTLE_SECONDS=60
EMERGENCY_OTP_EXPOSE_CODE=false

# Notification and OTP provider selection
# Use dev/test providers only with an explicitly enabled dev or test profile.
APP_NOTIFICATIONS_DEV_ENABLED=false
APP_SMS_PROVIDER=production
APP_EMAIL_PROVIDER=production
APP_OTP_STORE_PROVIDER=shared
APPOINTMENT_REMINDER_CRON=0 0 * * * *
